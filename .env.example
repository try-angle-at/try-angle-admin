# 로컬 실행: 이 파일을 .env 로 복사해서 값 채우기 (cp .env.example .env)

# API 서버 주소 — 끝에 /api 까지 포함 (엔드포인트가 /auth/login 처럼 /api 뒤 경로만 갖고 있음)
# 운영 EC2: http://52.78.214.200:8080/api   /   로컬 서버 개발 시: http://localhost:8080/api
VITE_API_BASE_URL=http://52.78.214.200:8080/api

# 이미지 공개 URL 베이스 — 서버가 저장한 파일 경로(profiles/..., reference/...) 앞에 붙는 주소
# 현재는 Cloudflare R2 공개 도메인. S3(CloudFront) 전환이 완료되면 새 주소로 교체할 것.
VITE_IMAGE_BASE_URL=https://pub-a309ad8a0a6e4a629ad982d710e35276.r2.dev

# API 타임아웃 (ms)
VITE_API_TIMEOUT=10000
